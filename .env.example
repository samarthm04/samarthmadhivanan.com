# Copy to .env.local for `vercel dev`, and set the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# Never commit real values.

# ── required ──────────────────────────────────────────────────────────

# Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Supabase → Project Settings → API. MUST be the service_role key (server-side only).
SUPABASE_URL=https://bedwevhnbjvvfqmnxswg.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Password for /admin.html — pick something long
ADMIN_PASSWORD=

# Any random string; salts the hashed visitor IPs
IP_SALT=

# ── lead notifications (optional; set either, neither, or both) ────────
# Without these, leads are still saved and visible in /admin.html → Leads.

# Email via Resend — https://resend.com (free tier)
RESEND_API_KEY=
# Defaults to samarthm04edu@gmail.com
LEAD_NOTIFY_TO=
# Defaults to onboarding@resend.dev. Once samarthmadhivanan.com is verified in
# Resend, change to e.g. "Samarth's Assistant <hello@samarthmadhivanan.com>"
LEAD_NOTIFY_FROM=

# Instant push to your phone via Telegram — talk to @BotFather for the token,
# then message your bot once and read the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
